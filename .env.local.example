# Copy this file to .env.local (which is already in .gitignore — never
# commit real values) and fill in the two values below once a Sanity
# project has been created at https://www.sanity.io/manage (free, ~2 min).
#
# Both projectId/dataset pairs below are the SAME values, just read by two
# different tools:
#   - SANITY_STUDIO_*  → read by the Sanity CLI when running the Studio
#                         (npm run studio:dev / studio:deploy)
#   - NEXT_PUBLIC_*    → read by the Next.js app once a future sprint wires
#                         Sanity data into pages (not used yet — see
#                         PROJECT.md Section 7). Prefixed NEXT_PUBLIC_
#                         because a project ID and dataset name aren't
#                         secret and the site needs them in the browser
#                         bundle to fetch images from Sanity's CDN.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
